# Production Environment Configuration
# For production deployment on Render and GitHub Pages

# Application Environment
NODE_ENV=production
FASTAPI_ENV=production
REACT_APP_ENV=production
ENVIRONMENT=production

# API Configuration
REACT_APP_API_URL=https://justlist.onrender.com
API_BASE_URL=https://justlist.onrender.com

# Database
DATABASE_URL=sqlite:///./data/facility_finder.db

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Places API
GOOGLE_PLACES_API_KEY=your-production-api-key-here

# CORS Settings
CORS_ORIGINS=https://techyz-software-solutions-pvt-ltd.github.io,https://techyz-software-solutions-pvt-ltd.github.io/justlist,http://localhost:3000,http://localhost:3001

# Rate Limiting
MAX_REQUESTS_PER_SESSION=500
SESSION_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Features
ENABLE_LEADS_MANAGEMENT=true
ENABLE_DEBUG_MODE=false
ENABLE_HOT_RELOAD=false

# Development Tools
ENABLE_API_DOCS=true
ENABLE_SWAGGER_UI=true

